[Unit]
Description=OTP Board server
After=network.target

[Service]
Type=simple
# Adjust to your actual install path (if you used install.sh, use that INSTALL_DIR/server).
WorkingDirectory=/opt/otp-board/server
ExecStart=/usr/bin/node /opt/otp-board/server/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# All runtime config (PORT / DOMAIN / ADMIN_PASSWORD / REFRESH_SEC / OTP_TOKEN)
# is read from server/.env by server.js (loadDotEnv) — edit .env, not this file.

[Install]
WantedBy=multi-user.target
