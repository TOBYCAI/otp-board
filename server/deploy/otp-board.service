[Unit]
Description=OTP Board Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/otp-board/server
ExecStart=/usr/bin/node /opt/otp-board/server/server.js
Restart=on-failure
RestartSec=5
Environment=PORT=3000
Environment=HOST=127.0.0.1
# Paste a generated token here (openssl rand -hex 16):
Environment=INGEST_TOKEN=
Environment=ADMIN_TOKEN=
Environment=DATA_FILE=/opt/otp-board/server/data/messages.json
Environment=RETENTION_DAYS=7

[Install]
WantedBy=multi-user.target
