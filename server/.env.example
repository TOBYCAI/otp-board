# Copy to .env and adjust. All values are OPTIONAL.

# Port / bind address for the HTTP server.
PORT=3000
HOST=0.0.0.0

# If set, every POST /otp must include this token (body.token or x-token header),
# otherwise 403 is returned. Generate one with:  openssl rand -hex 16
INGEST_TOKEN=

# If set, the dashboard (/) and /api/* endpoints require ?key=<token> or x-admin-token header.
# Leave empty to keep the dashboard open (dev only — never do this on a public host).
ADMIN_TOKEN=

# Where received codes are persisted (JSON file).
DATA_FILE=./data/messages.json

# Codes older than this many days are pruned every day at 23:59 (local time).
RETENTION_DAYS=7

# Basic per-IP rate limit for POST /otp.
RATE_LIMIT_COUNT=60
RATE_LIMIT_WINDOW_MS=60000
