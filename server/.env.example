# OTP Board server configuration (server.js reads this via loadDotEnv).
# Copy to .env and adjust. All values are OPTIONAL.

# HTTP listen port.
PORT=3001

# Public domain used for WebAuthn rpID/origin derivation and reverse-proxy notes.
DOMAIN=otp.example.com

# Admin console password (login at /admin).
ADMIN_PASSWORD=admin123

# Front-desk auto refresh interval in seconds.
REFRESH_SEC=5

# Push token: every POST /otp must carry it (body.token / query.token /
# x-otp-token / x-token), otherwise 403. Generate with: openssl rand -hex 16
OTP_TOKEN=

# Optional: force the WebAuthn origin (for tunnels/proxies that drop headers).
# OTP_PUBLIC_ORIGIN=https://your.domain
